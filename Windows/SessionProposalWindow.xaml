<Window x:Class="JiraTimeTracker.Windows.SessionProposalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0d1117" Foreground="#e6edf3" FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Title="Start Session" Width="420" Height="380"
        Topmost="True" Closing="Window_Closing">

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="Root" Margin="24" Opacity="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,4">
      <TextBlock x:Name="IdeLabel" Text="IDE detected"
                 FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                 Margin="0,0,0,6"/>
      <TextBlock Text="What are you working on?"
                 FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
    </StackPanel>

    <!-- Subtitle -->
    <TextBlock Grid.Row="1" x:Name="SubLabel"
               Text="Pick a Jira issue to start tracking time."
               Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,4,0,16"/>

    <!-- Search -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}"
               ToolTip="Search by issue key (KAN-1) or keywords"
               TextChanged="SearchBox_TextChanged"/>
      <TextBlock Text="🔍  Search by key or keyword…" IsHitTestVisible="False"
                 Foreground="#484f58" FontSize="12" Margin="12,0,0,0"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- Loading / Error -->
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Loading your issues…"
               Foreground="{StaticResource SubtextBrush}" FontSize="12"
               Margin="0,0,0,8" Visibility="Visible"/>

    <!-- Issue list -->
    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Margin="0,0,0,16">
      <ListBox x:Name="IssueList" Style="{StaticResource DarkList}"
               BorderThickness="0" Background="Transparent"
               SelectionChanged="IssueList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Issue key badge -->
              <Border Grid.Column="0" Background="#1c3a5e" CornerRadius="4"
                      Padding="7,3" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding Key}" Foreground="#58a6ff"
                           FontWeight="SemiBold" FontSize="12"/>
              </Border>

              <!-- Summary -->
              <TextBlock Grid.Column="1" Text="{Binding Summary}"
                         Foreground="#e6edf3" FontSize="13"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

              <!-- Status pill -->
              <Border Grid.Column="2"
                      Background="{Binding Status, Converter={StaticResource StatusBg}}"
                      CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="10"
                           Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Padding"                 Value="8,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#21262d"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1f3258"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </Border>

    <!-- Buttons -->
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="NoIssuesText"
                 Text="No open issues found." Visibility="Collapsed"
                 Foreground="{StaticResource YellowBrush}" FontSize="12"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="↺  Refresh" Style="{StaticResource GhostBtn}"
              Click="Refresh_Click" Padding="12,8"/>
      <Button Grid.Column="4" x:Name="StartBtn" Content="▶  Start Tracking"
              Style="{StaticResource PrimaryBtn}" IsEnabled="False"
              Click="Start_Click" Padding="18,8"/>
    </Grid>
  </Grid>
</Window>
