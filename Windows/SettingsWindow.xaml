<Window x:Class="JiraTimeTracker.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0d1117" Foreground="#e6edf3" FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Settings" Width="480" Height="720">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

    <!-- Jira Section -->
    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="JIRA CONNECTION" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="Workspace URL" Style="{StaticResource Label}"/>
        <TextBox x:Name="UrlBox" Style="{StaticResource DarkInput}" Margin="0,0,0,12"
                 ToolTip="https://yourcompany.atlassian.net"/>
        <TextBlock Text="Email" Style="{StaticResource Label}"/>
        <TextBox x:Name="EmailBox" Style="{StaticResource DarkInput}" Margin="0,0,0,12"/>
        <TextBlock Text="API Token" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="TokenBox" Style="{StaticResource DarkPassword}"/>
        <Button Content="Test Connection" Style="{StaticResource GhostBtn}"
                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0,6"
                Click="TestConn_Click"/>
        <TextBlock x:Name="ConnStatus" Text="" FontSize="11" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- Tracker Section -->
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="TRACKER" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Idle timeout (minutes)" Style="{StaticResource Label}"/>
            <TextBox x:Name="IdleBox" Style="{StaticResource DarkInput}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Scan interval (seconds)" Style="{StaticResource Label}"/>
            <TextBox x:Name="ScanBox" Style="{StaticResource DarkInput}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Watched Apps Section -->
    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="WATCHED APPS" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Tracker will prompt you when any of these processes start."
                   Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="NewProcessBox" Style="{StaticResource DarkInput}"
                   Grid.Column="0" ToolTip="e.g. Code, devenv, rider64"
                   KeyDown="NewProcessBox_KeyDown"/>
          <Button Grid.Column="2" Content="+ Add" Style="{StaticResource PrimaryBtn}"
                  Padding="14,8" Click="AddProcess_Click"/>
        </Grid>
        <ListBox x:Name="ProcessList" Style="{StaticResource DarkList}"
                 MaxHeight="100" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"/>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostBtn}"
                        Padding="8,2" FontSize="11" Tag="{Binding}"
                        Click="RemoveProcess_Click"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Logging -->
    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="LOGGING" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="160"/>
          </Grid.ColumnDefinitions>
          <CheckBox x:Name="LogToFileCheck" Grid.Column="0"
                    Content="Write logs to file" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Log level" Style="{StaticResource Label}"/>
            <ComboBox x:Name="LogLevelCombo" Style="{StaticResource DarkCombo}">
              <ComboBoxItem Content="Debug (everything)"/>
              <ComboBoxItem Content="Info"/>
              <ComboBoxItem Content="Warning"/>
              <ComboBoxItem Content="Errors only"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Log file: " Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
          <TextBlock x:Name="LogPathLabel" Text="" Foreground="{StaticResource AccentBrush}"
                     FontSize="11" Cursor="Hand" TextDecorations="Underline"
                     MouseLeftButtonUp="LogPath_Click"
                     TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Startup & Updates -->
    <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="STARTUP &amp; UPDATES" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <CheckBox x:Name="StartupCheck" Foreground="{StaticResource TextBrush}" FontSize="13"
                  Content="Launch Trakr when Windows starts" Margin="0,0,0,10"/>
        <CheckBox x:Name="AutoUpdateCheck" Foreground="{StaticResource TextBrush}" FontSize="13"
                  Content="Automatically check for updates on startup"/>
        <TextBlock Text="When enabled, the app silently downloads updates in the background and prompts you to restart."
                   Foreground="{StaticResource SubtextBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="22,4,0,0"/>

        <!-- Theme selector -->
        <TextBlock Text="APPEARANCE" Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,18,0,10"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Theme" Foreground="{StaticResource TextBrush}" FontSize="13"
                     VerticalAlignment="Center" Margin="0,0,14,0"/>
          <ComboBox x:Name="ThemeCombo" Style="{StaticResource DarkCombo}"
                    Width="160" SelectionChanged="ThemeCombo_SelectionChanged">
            <ComboBoxItem Content="Default" Tag="Default"/>
            <ComboBoxItem Content="Jira"    Tag="Jira"/>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Buttons -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostBtn}" Click="Cancel_Click"/>
      <Button Grid.Column="3" Content="Save"   Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
