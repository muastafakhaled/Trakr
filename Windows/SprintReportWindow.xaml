<Window x:Class="JiraTimeTracker.Windows.SprintReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0d1117" Foreground="#e6edf3" FontFamily="Segoe UI" FontSize="13" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Title="Sprint Report" Width="900" Height="600">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Sprint Report" FontSize="18" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Range" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
      <ComboBox Grid.Column="1" x:Name="RangeCombo" Style="{StaticResource DarkCombo}"
                SelectionChanged="RangeCombo_Changed">
        <ComboBoxItem Content="This week"    IsSelected="True"/>
        <ComboBoxItem Content="Last sprint (2 weeks)"/>
        <ComboBoxItem Content="This month"/>
        <ComboBoxItem Content="All time"/>
        <ComboBoxItem Content="Custom"/>
      </ComboBox>
      <TextBlock Grid.Column="3" x:Name="FromLabel" Text="From" Style="{StaticResource Label}"
                 VerticalAlignment="Center" Margin="0" Visibility="Collapsed"/>
      <DatePicker Grid.Column="4" x:Name="FromDate" Visibility="Collapsed"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"/>
      <TextBlock Grid.Column="6" x:Name="ToLabel" Text="To" Style="{StaticResource Label}"
                 VerticalAlignment="Center" Margin="0" Visibility="Collapsed"/>
      <DatePicker Grid.Column="7" x:Name="ToDate" Visibility="Collapsed"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"/>
      <Button Grid.Column="9" Content="Refresh" Style="{StaticResource GhostBtn}"
              Click="Refresh_Click" Padding="14,7"/>
    </Grid>

    <!-- Summary Cards -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="20,12" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock x:Name="TotalTimeText" Text="0h" FontSize="24" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"/>
          <TextBlock Text="Total Time" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="20,12" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock x:Name="IssuesText" Text="0" FontSize="24" FontWeight="Bold"
                     Foreground="{StaticResource GreenBrush}"/>
          <TextBlock Text="Issues Worked" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="20,12" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock x:Name="SessionsText" Text="0" FontSize="24" FontWeight="Bold"
                     Foreground="{StaticResource YellowBrush}"/>
          <TextBlock Text="Sessions" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="20,12">
        <StackPanel>
          <TextBlock x:Name="LoggedText" Text="0" FontSize="24" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Logged to Jira" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Grid -->
    <DataGrid Grid.Row="3" x:Name="SessionGrid" Style="{StaticResource DarkGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date"     Binding="{Binding Date}"          Width="100"/>
        <DataGridTextColumn Header="Issue"    Binding="{Binding IssueKey}"      Width="90"/>
        <DataGridTextColumn Header="Repo"     Binding="{Binding RepoName}"      Width="140"/>
        <DataGridTextColumn Header="Duration" Binding="{Binding DurationHuman}" Width="90"/>
        <DataGridTextColumn Header="Start"    Binding="{Binding StartDisplay}"  Width="80"/>
        <DataGridTextColumn Header="End"      Binding="{Binding EndDisplay}"    Width="80"/>
        <DataGridTextColumn Header="Pauses"   Binding="{Binding Pauses}"        Width="65"/>
        <DataGridTextColumn Header="Mode"     Binding="{Binding SessionMode}"   Width="65"/>
        <DataGridTextColumn Header="Jira"     Binding="{Binding JiraDisplay}"   Width="60"/>
        <DataGridTextColumn Header="Branch"   Binding="{Binding Branch}"        Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Button Grid.Row="4" Content="Open sessions.csv" Style="{StaticResource GhostBtn}"
            HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenCsv_Click"/>
  </Grid>
</Window>