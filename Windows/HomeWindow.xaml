<Window x:Class="JiraTimeTracker.Windows.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Title="Trakr" Width="520" Height="720"
        MinWidth="460" MinHeight="580"
        Closing="Window_Closing" KeyDown="Window_KeyDown">

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.25"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="RootGrid" Margin="24" Opacity="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDotOuter" Width="14" Height="14" Fill="Transparent" Opacity="0.3"/>
          <Ellipse x:Name="StatusDot" Width="10" Height="10"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="Trakr" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="TodayLabel" Text=""
                 Foreground="{StaticResource SubtextBrush}" FontSize="11"
                 VerticalAlignment="Center"/>
    </Grid>

    <!-- Setup Warning -->
    <Border Grid.Row="1" x:Name="SetupBanner" Background="#2d1f00"
            BorderBrush="{StaticResource YellowBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x26A0;  Jira not configured. " Foreground="{StaticResource YellowBrush}" FontSize="12"/>
        <TextBlock Text="Open Settings" Foreground="{StaticResource AccentBrush}" FontSize="12"
                   Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="SetupLink_Click"/>
      </StackPanel>
    </Border>

    <!-- Status Card -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="20" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusLabel" Text="NOT TRACKING"
                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="IssueLabel" Text="&#x2014;"
                     FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Grid.Column="1" x:Name="TimerLabel" Text=""
                     FontSize="30" FontWeight="Bold" Foreground="{StaticResource SubtextBrush}"
                     VerticalAlignment="Bottom"/>
        </Grid>

        <StackPanel Grid.Row="2">
          <TextBlock x:Name="BranchLabel" Text="Open an IDE or click Start to begin"
                     Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
          <TextBlock x:Name="RepoLabel" Text=""
                     Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pause Banner -->
    <Border Grid.Row="3" x:Name="PauseBanner" Background="#2d2200"
            BorderBrush="{StaticResource YellowBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock x:Name="PauseLabel" Text="&#x23F8;  Paused"
                 Foreground="{StaticResource YellowBrush}" FontSize="12"/>
    </Border>

    <!-- Action Buttons -->
    <Grid Grid.Row="4" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="StartBtn" Content="&#x25B6;  Start Manually"
              Style="{StaticResource PrimaryBtn}" Click="Start_Click"/>
      <Button Grid.Column="2" x:Name="StopBtn" Content="&#x23F9;  Stop &amp; Log"
              Style="{StaticResource DangerBtn}" IsEnabled="False" Click="Stop_Click"
              BorderBrush="{StaticResource RedBrush}" BorderThickness="1"/>
    </Grid>

    <!-- Tab strip + content panels -->
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Tab strip -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" x:Name="TabSessions" Text="SESSIONS"
                   FontSize="10" FontWeight="SemiBold" Cursor="Hand"
                   Padding="0,0,16,0" VerticalAlignment="Center"
                   MouseLeftButtonUp="TabSessions_Click"/>
        <TextBlock Grid.Column="1" x:Name="TabIssues" Text="MY ISSUES"
                   FontSize="10" FontWeight="SemiBold" Cursor="Hand"
                   Padding="0,0,16,0" VerticalAlignment="Center"
                   MouseLeftButtonUp="TabIssues_Click"/>
        <TextBlock Grid.Column="2" x:Name="TabLog" Text="LIVE LOG"
                   FontSize="10" FontWeight="SemiBold" Cursor="Hand"
                   Padding="0,0,16,0" VerticalAlignment="Center"
                   MouseLeftButtonUp="TabLog_Click" Visibility="Collapsed"/>

        <!-- Refresh + Group toggle (issues tab only) -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Visibility="Collapsed"
                    x:Name="IssueTabActions">
          <CheckBox x:Name="GroupSubtasksCheck" Content="Group subtasks"
                    IsChecked="True" FontSize="10"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    Checked="GroupSubtasks_Changed" Unchecked="GroupSubtasks_Changed"/>
          <TextBlock x:Name="IssueRefreshLabel" Text="&#x21BA; refresh"
                     FontSize="10" Foreground="{StaticResource AccentBrush}"
                     Cursor="Hand" VerticalAlignment="Center"
                     MouseLeftButtonUp="IssueRefresh_Click"/>
        </StackPanel>
      </Grid>

      <!-- SESSIONS panel -->
      <StackPanel Grid.Row="1" x:Name="SessionsPanel">
        <!-- Live log -->
        <Border x:Name="LogPanel" Visibility="Collapsed"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,8" MaxHeight="120">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
            <ItemsControl x:Name="LogList" Margin="12,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{StaticResource SubtextBrush}"
                             FontSize="11" FontFamily="Consolas" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Recent sessions list -->
        <Border x:Name="RecentPanel"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <ListBox x:Name="RecentList" Style="{StaticResource DarkList}"
                     BorderThickness="0" Background="Transparent" MaxHeight="180"
                     MouseDoubleClick="RecentList_DoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="55"/>
                      <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1f3258" CornerRadius="4"
                            Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding IssueKey}" Foreground="#58a6ff"
                                 FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding RepoName}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                      <TextBlock Text="{Binding Date}" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationHuman}"
                               Foreground="{StaticResource TextBrush}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding JiraDisplay}" Margin="8,0,0,0"
                               Foreground="{StaticResource GreenBrush}" FontSize="13"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="8,2"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#21262d"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#1f3258"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="12,8">
              <TextBlock Text="Double-click a session to open in Jira"
                         Foreground="{StaticResource SubtextBrush}" FontSize="10"
                         HorizontalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ISSUES panel -->
      <Grid Grid.Row="1" x:Name="IssuesPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBox x:Name="IssueSearchBox" Style="{StaticResource DarkInput}"
                   TextChanged="IssueSearch_TextChanged"/>
          <TextBlock Text="&#x1F50D;  Filter issues..." IsHitTestVisible="False"
                     Foreground="#484f58" FontSize="12" Margin="12,0,0,0"
                     VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=IssueSearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <!-- Status / list -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
          <Grid>
            <TextBlock x:Name="IssueStatusText" Text="Loading..."
                       Foreground="{StaticResource SubtextBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="IssueEmptyText" Text="No open issues found."
                       Foreground="{StaticResource SubtextBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ListBox x:Name="IssueList" Style="{StaticResource DarkList}"
                     BorderThickness="0" Background="Transparent"
                     SelectionChanged="IssueList_SelectionChanged"
                     MouseDoubleClick="IssueList_DoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Parent key hint — only visible for grouped subtasks (parent present in list) -->
                    <TextBlock Grid.Row="0" Text="{Binding ParentLabel}"
                               Foreground="#484f58" FontSize="10" FontFamily="Consolas"
                               Margin="50,3,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- Issue row -->
                    <Grid Grid.Row="1" Margin="4,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding GroupedIndent}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Indent spacer -->
                      <Border Grid.Column="0"/>
                      <!-- Expand/collapse chevron (only for parents with subtasks) -->
                      <Button Grid.Column="1" Tag="{Binding Key}"
                              Click="IssueExpandToggle_Click"
                              Background="Transparent" BorderThickness="0"
                              Width="16" Padding="0" Cursor="Hand" VerticalAlignment="Center"
                              Focusable="False">
                        <Button.Style>
                          <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                  <Border Background="Transparent"
                                          Width="{TemplateBinding Width}"
                                          Height="22">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                  </Border>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasSubtasks}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Viewbox Width="10" Height="10" Stretch="Uniform">
                          <Path Data="{Binding IsExpanded, Converter={StaticResource ChevronGeometry}}"
                                Fill="#8b949e"/>
                        </Viewbox>
                      </Button>
                      <!-- Issue type icon -->
                      <Viewbox Grid.Column="2" Width="14" Height="14" Stretch="Uniform"
                               VerticalAlignment="Center" ToolTip="{Binding IssueType}">
                        <Path Data="{Binding ResolvedType, Converter={StaticResource IssueTypeGeometry}}"
                              Fill="{Binding IssueTypeColor, Converter={StaticResource IssueTypeColor}}"/>
                      </Viewbox>
                      <!-- Issue key -->
                      <TextBlock Grid.Column="3" Text="{Binding Key}"
                                 Foreground="{Binding IssueTypeColor, Converter={StaticResource IssueTypeColor}}"
                                 FontWeight="SemiBold" FontSize="12" FontFamily="Consolas"
                                 VerticalAlignment="Center" Margin="8,0,6,0"
                                 TextTrimming="CharacterEllipsis"/>
                      <!-- Summary -->
                      <TextBlock Grid.Column="4" Text="{Binding Summary}"
                                 Foreground="#e6edf3" FontSize="12" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <!-- Status pill -->
                      <Border Grid.Column="5"
                              Background="{Binding Status, Converter={StaticResource StatusBg}}"
                              CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                      </Border>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background"              Value="Transparent"/>
                  <Setter Property="Padding"                 Value="8,2"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Cursor"                  Value="Hand"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#21262d"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#1f3258"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>
        </Border>

        <!-- Set to In Progress + Start button -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <CheckBox Grid.Row="0" x:Name="SetInProgressCheck"
                    Content="Set issue to In Progress when starting"
                    IsChecked="True"
                    Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
          <Button Grid.Row="2" x:Name="IssueStartBtn" Content="&#x25B6;  Start Tracking"
                  Style="{StaticResource PrimaryBtn}" IsEnabled="False"
                  Click="IssueStart_Click"/>
        </Grid>
      </Grid>

      <!-- LIVE LOG panel -->
      <Border Grid.Row="1" x:Name="LiveLogPanel" Visibility="Collapsed"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <ScrollViewer x:Name="LiveLogScroller" VerticalScrollBarVisibility="Auto" Background="Transparent">
          <ItemsControl x:Name="LiveLogList" Margin="12,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{StaticResource SubtextBrush}"
                           FontSize="11" FontFamily="Consolas" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom Nav -->
    <Grid Grid.Row="6" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Report"   Style="{StaticResource GhostBtn}" Click="Report_Click"/>
      <Button Grid.Column="1" Content="Repos"    Style="{StaticResource GhostBtn}" Click="Repos_Click"/>
      <Button Grid.Column="2" Content="Logs"     Style="{StaticResource GhostBtn}" Click="Logs_Click"/>
      <Button Grid.Column="3" Content="&#x2699; Settings"  Style="{StaticResource GhostBtn}" Click="Settings_Click"/>
    </Grid>
  </Grid>
</Window>
