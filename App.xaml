<Application x:Class="JiraTimeTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JiraTimeTracker.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:StatusBgConverter       x:Key="StatusBg"/>
      <conv:StatusFgConverter       x:Key="StatusFg"/>
      <conv:IssueTypeColorConverter    x:Key="IssueTypeColor"/>
      <conv:IssueTypeGeometryConverter x:Key="IssueTypeGeometry"/>
      <conv:ChevronGeometryConverter   x:Key="ChevronGeometry"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
